rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    // Safer get user data function
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role checks
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // Supports both Spanish and English role names for robustness
    function isAdmin() {
      return isAuthenticated() && (getUserData().role in ['administrador', 'admin', 'Admin']);
    }

    function isSeller() {
      return isAuthenticated() && (getUserData().role in ['vendedor', 'seller', 'Seller']);
    }

    function isTechnician() {
      return isAuthenticated() && (getUserData().role in ['tecnico', 'technician', 'Technician']);
    }

    function isAccounting() {
      return isAuthenticated() && (getUserData().role in ['contabilidad', 'accounting', 'Accounting']);
    }

    function isStaff() {
      return isAuthenticated() && (
        getUserData().role in [
          'administrador', 'admin', 'Admin',
          'vendedor', 'seller', 'Seller',
          'tecnico', 'technician', 'Technician',
          'contabilidad', 'accounting', 'Accounting'
        ]
      );
    }

    // Un cliente autenticado solo puede crear/actualizar registros contables
    // vinculados a una orden que le pertenece (integración contable automática
    // al comprar desde el carrito).
    function isOwnOrder(orderId) {
      return isAuthenticated() && orderId != null && orderId != '' &&
        get(/databases/$(database)/documents/orders/$(orderId)).data
          .get('userId', '') == request.auth.uid;
    }

    // --- Collection Rules ---

    // Users: Complex rules for privacy and role management
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      
      allow create: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      
      allow update: if isAuthenticated() && (
        // User updating their own profile (excluding role)
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roleUpdatedAt', 'roleUpdatedBy'])) ||
        // Admin can update everything
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // Catalog (Products, Services, Categories) & Config
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuración inicial del negocio (wizard contable) y empleados
    match /business_config/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAccounting();
    }

    match /business_employees/{employeeId} {
      allow read: if isStaff();
      allow write: if isAdmin() || isAccounting();
    }

    // Quotes & Orders
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && (
        resource.data.get('customerUid', '') == request.auth.uid ||
        resource.data.get('clientId', '') == request.auth.uid ||
        isStaff()
      );
      allow create: if isStaff();
      allow update: if isAuthenticated() && (
        isStaff() || 
        ((resource.data.get('customerUid', '') == request.auth.uid) && 
         request.resource.data.status in ['approved', 'rejected', 'aprobada', 'rechazada'])
      );
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('originalQuote', {}).get('customerUid', '') == request.auth.uid ||
        isStaff()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        isStaff()
      );
      allow update: if isStaff() && (resource.data.status != 'entregado' || isAdmin());
      allow delete: if isAdmin();

      match /payments/{paymentId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data
            .get('userId', '') == request.auth.uid ||
          isStaff()
        );
        allow create: if isStaff();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // Reservations
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        isStaff()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        isStaff()
      );
      allow update: if (isStaff() || 
        (resource.data.get('userId', '') == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))) &&
        (resource.data.status != 'completada' || isAdmin());
        
      allow delete: if isAdmin();

      match /payments/{paymentId} {
        allow read: if isAuthenticated() && (
          resource.data.get('userId', '') == request.auth.uid ||
          isStaff()
        );
        allow create: if isStaff();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.get('receiverId', '') == request.auth.uid ||
        isStaff() || 
        resource.data.get('receiverRole', '') == getUserData().role ||
        resource.data.get('receiverRole', '') == 'all'
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        (resource.data.get('receiverId', '') == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])) ||
        isStaff()
      );
      allow delete: if resource.data.get('receiverId', '') == request.auth.uid || isStaff();
    }

    // Suppliers (Proveedores)
    match /suppliers/{supplierId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Sequential ID counters (used by DocumentIdService for atomic IDs).
    // Clients generate order/payment IDs when buying from the cart, so any
    // authenticated user may read/write counters.
    match /_counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // Marketing Logs
    match /marketing_logs/{logId} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Inventory Movements (staff records purchases/sales; clients never write)
    match /inventory_movements/{movementId} {
      allow read: if isAuthenticated() && isStaff();
      allow write: if isStaff();
    }

    // --- Módulo Contable (Accounting) ---
    //
    // La integración contable automática se dispara desde operaciones que
    // ejecutan clientes (compra en carrito), vendedores y técnicos, por lo que
    // el CREATE de transacciones/asientos/CxC se permite a staff o al dueño de
    // la orden referenciada. La gestión manual (update/delete) queda para
    // admin/contabilidad.

    match /accounting_transactions/{transactionId} {
      allow read: if isStaff();
      allow create: if isStaff() ||
        isOwnOrder(request.resource.data.get('referenceId', ''));
      allow update: if isAdmin() || isAccounting() || isStaff();
      allow delete: if isAdmin();

      // Historial previo de cada transacción al ser modificada
      match /_history/{historyId} {
        allow read: if isStaff();
        allow write: if isAdmin() || isAccounting() || isStaff();
      }
    }

    match /accounting_closures/{closureId} {
      allow read: if isStaff();
      allow create: if isAdmin() || isAccounting();
      allow update, delete: if isAdmin();
    }

    match /accounting_invoices/{invoiceId} {
      allow read: if isStaff();
      allow create: if isAdmin() || isAccounting();
      allow update: if isAdmin() || isAccounting();
      allow delete: if isAdmin();
    }

    // Facturas de compra y gastos (fuente de verdad de compras). El personal
    // registra facturas (incluidas las generadas al registrar movimientos de
    // inventario IN); la gestión estructural queda para admin/contabilidad.
    match /purchase_invoices/{invoiceId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAdmin() || isAccounting() || isStaff();
      allow delete: if isAdmin();
    }

    match /chart_of_accounts/{accountId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isAccounting();
      // Los asientos automáticos (clientes comprando, ventas, compras) solo
      // actualizan el campo `balance`; la edición estructural queda para
      // admin/contabilidad.
      allow update: if isAdmin() || isAccounting() ||
        (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']));
      allow delete: if isAdmin() || isAccounting();
    }

    match /accounting_entries/{entryId} {
      allow read: if isStaff();
      allow create: if isStaff() ||
        isOwnOrder(request.resource.data.get('referenceId', ''));
      allow update: if isAdmin() || isAccounting();
      allow delete: if isAdmin();
    }

    // Diario legado/consulta de reportes financieros
    match /journal_entries/{entryId} {
      allow read: if isStaff();
      allow write: if isAdmin() || isAccounting();
    }

    match /accounts_receivable/{receivableId} {
      allow read: if isStaff();
      allow create: if isStaff() ||
        isOwnOrder(request.resource.data.get('originId', ''));
      allow update: if isAdmin() || isAccounting() || isStaff();
      allow delete: if isAdmin();
      match /payments/{paymentId} {
        allow read: if isStaff();
        allow create: if isStaff();
        allow update: if isAdmin() || isAccounting();
        allow delete: if isAdmin();
      }
    }

    match /accounts_payable/{payableId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAdmin() || isAccounting() || isStaff();
      allow delete: if isAdmin();
      match /payments/{paymentId} {
        allow read: if isStaff();
        allow create: if isStaff();
        allow update: if isAdmin() || isAccounting();
        allow delete: if isAdmin();
      }
    }

    match /bank_reconciliation/{reconId} {
      allow read: if isStaff();
      allow create: if isAdmin() || isAccounting();
      allow update: if isAdmin() || isAccounting();
      allow delete: if isAdmin();
    }

    match /receipt_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAccounting();
    }

    // --- Nómina (Payroll) ---
    match /payroll_entries/{payrollId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isAccounting();
      allow delete: if isAdmin();
    }

    // --- NUEVO: Presupuestos (Budget vs Actual) ---
    match /budgets/{budgetId} {
      allow read: if isStaff();
      allow create: if isAdmin() || isAccounting();
      allow update: if isAdmin() || isAccounting();
      allow delete: if isAdmin();
    }

    // --- NUEVO: Activos Fijos (depreciación) ---
    match /fixed_assets/{assetId} {
      allow read: if isStaff();
      allow create: if isAdmin() || isAccounting() || isStaff();
      allow update: if isAdmin() || isAccounting() || isStaff();
      allow delete: if isAdmin();
    }
  }
}
